{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:lan": "vite --host 0.0.0.0",
        "serve:lan": "php artisan serve --host=0.0.0.0 --port=8080 --no-reload",
        "lan": "concurrently -n server,vite -c blue,magenta \"npm run serve:lan\" \"npm run dev:lan\"",
        "lan:demo": "npm run build && php artisan serve --host=0.0.0.0 --port=8080 --no-reload"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.2.4"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "i": "^0.3.7",
        "jsbarcode": "^3.12.3",
        "quill": "^2.0.3"
    }
}
